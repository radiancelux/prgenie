# Copy to .env for local development (never commit .env).

# --- Local runner (local-runner/) ---
PRGENIE_RUNNER_TOKEN=change-me-local-secret
PRGENIE_RUNNER_HOST=127.0.0.1
PRGENIE_RUNNER_PORT=9473
PRGENIE_RUNNER_DATA_DIR=
PRGENIE_RUNNER_MODEL=composer-2.5
PRGENIE_RUNNER_DRY_RUN=
PRGENIE_RUNNER_DEFAULT_REPO_PATH=
PRGENIE_RUNNER_NOTIFY_EMAIL=you@example.com
PRGENIE_RUNNER_FROM_EMAIL=PR Genie Local Runner <runner@example.com>
RESEND_API_KEY=
PRGENIE_RUNNER_RESEND_KEY_FILE=

# --- CLI / plugin / core ---
PRGENIE_GIT=
PRGENIE_GITHUB_GATE_ASK=
PRGENIE_CAPTURE_SUBAGENT=
PRGENIE_AGENT_HOME=
PRGENIE_CI_FAIL_FAST=
PRGENIE_CI_PARALLEL=
PRGENIE_CI_HEAVY_CONCURRENCY=
PRGENIE_CI_HEAVY_SLOT_HELD=

# Cursor MCP / workspace (set by IDE)
# CURSOR_PROJECT_DIR=
# WORKSPACE_FOLDER_PATHS=
# CURSOR_PLUGIN_ROOT=
