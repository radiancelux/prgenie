{
  "name": "prgenie",
  "private": true,
  "version": "0.1.2",
  "description": "Local pull requests for agent work. GitHub when you say so.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/radiancelux/prgenie.git"
  },
  "bugs": "https://github.com/radiancelux/prgenie/issues",
  "homepage": "https://github.com/radiancelux/prgenie#readme",
  "author": "PR Genie contributors",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx --test \"packages/*/src/**/*.test.ts\" \"local-runner/src/**/*.test.ts\"",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/cli --noEmit && tsc -p packages/extension --noEmit && tsc -p local-runner --noEmit",
    "lint": "eslint packages/core/src packages/cli/src packages/extension/src scripts",
    "lint:fix": "eslint packages/core/src packages/cli/src packages/extension/src scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "node packages/cli/dist/prgenie.cjs",
    "link-plugin": "powershell -ExecutionPolicy Bypass -File scripts/link-plugin.ps1",
    "link-extension": "powershell -ExecutionPolicy Bypass -File scripts/link-extension.ps1",
    "check-versions": "node scripts/check-versions.mjs",
    "pack:extension": "node scripts/pack-extension.mjs",
    "local-runner": "node local-runner/dist/runner.cjs",
    "build:test": "node scripts/build-test.mjs",
    "pack:runner": "node scripts/pack-runner.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.17.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.9",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "@tailwindcss/cli": "4.1.11",
    "tailwindcss": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
