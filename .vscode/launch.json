{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PR Genie Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension",
        "--disable-extensions",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/packages/extension/dist/**/*.js"],
      "stopOnEntry": false,
      "sourceMaps": true,
      "debugWebWorkerExtensions": false
    }
  ]
}
