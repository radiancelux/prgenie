{
  "name": "prgenie",
  "displayName": "PR Genie",
  "description": "Local pull requests for agent work. GitHub when you say so.",
  "version": "0.1.0",
  "publisher": "prgenie",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["SCM Providers", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "dependencies": {
    "@prgenie/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/vscode": "^1.85.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prgenie",
          "title": "PR Genie",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "prgenie": [
        {
          "type": "webview",
          "id": "prgenie.lane",
          "name": "Local PRs"
        }
      ]
    },
    "commands": [
      {
        "command": "prgenie.refresh",
        "title": "PR Genie: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "prgenie.createPr",
        "title": "PR Genie: Create Local PR"
      }
    ]
  }
}
