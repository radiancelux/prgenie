{
  "name": "prgenie",
  "displayName": "PR Genie",
  "description": "Local pull requests for agent work. GitHub when you say so.",
  "version": "0.1.0",
  "publisher": "prgenie",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["SCM Providers", "Other"],
  "activationEvents": [
    "onStartupFinished",
    "onView:prgenie.lane",
    "onView:prgenie.panel"
  ],
  "main": "./dist/extension.js",
  "dependencies": {
    "@prgenie/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/vscode": "^1.85.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prgenie",
          "title": "PR Genie",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "prgenie-panel",
          "title": "PR Genie",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "prgenie": [
        {
          "type": "webview",
          "id": "prgenie.lane",
          "name": "Local PRs",
          "visibility": "visible"
        }
      ],
      "prgenie-panel": [
        {
          "type": "webview",
          "id": "prgenie.panel",
          "name": "Packet",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "prgenie.refresh",
        "title": "PR Genie: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "prgenie.createPr",
        "title": "PR Genie: Create Local PR",
        "icon": "$(add)"
      },
      {
        "command": "prgenie.openLane",
        "title": "PR Genie: Open Local PRs"
      },
      {
        "command": "prgenie.openPanel",
        "title": "PR Genie: Open Packet Panel"
      },
      {
        "command": "prgenie.openGitLens",
        "title": "PR Genie: Open GitLens Graph",
        "icon": "$(git-merge)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "prgenie.createPr",
          "when": "view == prgenie.lane",
          "group": "navigation"
        },
        {
          "command": "prgenie.refresh",
          "when": "view == prgenie.lane || view == prgenie.panel",
          "group": "navigation"
        },
        {
          "command": "prgenie.openGitLens",
          "when": "view == prgenie.lane || view == prgenie.panel",
          "group": "navigation"
        }
      ]
    }
  }
}
